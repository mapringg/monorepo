{
  "name": "api",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./src/client.ts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "NODE_ENV=development tsx watch src/server.ts",
    "start": "node dist/server.mjs",
    "test": "vitest run",
    "test:changed": "vitest run --changed",
    "prepare": "tsdown"
  },
  "dependencies": {
    "@hono/node-server": "catalog:",
    "@repo/i18n": "workspace:*",
    "@scalar/hono-api-reference": "catalog:",
    "@standard-schema/spec": "catalog:",
    "hono": "catalog:",
    "hono-openapi": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "vitest": "catalog:"
  }
}
